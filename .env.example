# Учётные данные. Compose подставляет их в Postgres, RabbitMQ и URL внутри сети.
# DATABASE_URL и RABBITMQ_URL ниже — для запуска на хосте и для pytest (localhost).
# В контейнерах compose переопределяет их на хосты postgres и rabbitmq.
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payment
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5432/payment
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_KEY=dev-api-key
WEBHOOK_SECRET=dev-webhook-secret
OUTBOX_RELAY_ENABLED=true
